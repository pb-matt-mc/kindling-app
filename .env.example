# Orbit settings. Copy to .env (never commit it). The old KINDLING_* names still work.
# "mock" = fake listings, no spend. "scrapecreators" = real Marketplace listings.
ORBIT_SOURCE=mock
SCRAPECREATORS_API_KEY=
ANTHROPIC_API_KEY=

# Optional alternative source (only used when ORBIT_SOURCE=apify)
APIFY_TOKEN=
# APIFY_ACTOR=apify/facebook-marketplace-scraper
# APIFY_RESULTS_PER_QUERY=20

# ORBIT_MODEL_SCREEN=claude-haiku-5-5
# ORBIT_MODEL_SCORE=claude-sonnet-5-5

# Optional: a folder in your Obsidian vault for batch and system notes
ORBIT_OBSIDIAN_DIR=

# ORBIT_PHOTOS_PER_LISTING=3
# ORBIT_EXPLORE_SHARE=0.2
