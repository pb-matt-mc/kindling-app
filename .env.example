# Copy to .env and fill in. Never commit .env.

# Where listings come from: scrapecreators | apify | mock (mock = fake listings, nothing spent)
KINDLING_SOURCE=scrapecreators
SCRAPECREATORS_API_KEY=

# Optional alternative source (only used when KINDLING_SOURCE=apify)
APIFY_TOKEN=
APIFY_RESULTS_PER_QUERY=20

# Claude does the judging. Without a key the app falls back to keyword guesses.
ANTHROPIC_API_KEY=
# KINDLING_MODEL_SCREEN=claude-haiku-5-5
# KINDLING_MODEL_SCORE=claude-sonnet-5-5

# Optional: absolute path to a folder in the Obsidian vault; a note is written per finished batch
KINDLING_OBSIDIAN_DIR=

# Optional tuning
# KINDLING_PHOTOS_PER_LISTING=3
# KINDLING_EXPLORE_SHARE=0.2
