# Template. Replace every <PLACEHOLDER> before installing.
[Unit]
Description=Kindling (Marketplace swipe app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/kindling
ExecStart=/home/<USER>/kindling/.venv/bin/uvicorn app.main:app --host <BIND_ADDRESS> --port 8010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
